# 喵杀（MEOWCHA）· 环境变量示例
# 复制为 `.env.local`（本地开发）或 `.env`（构建时），按需填写。
# 说明：Next.js 只会把以 NEXT_PUBLIC_ 开头的变量注入到浏览器端。

# ─────────────────────────────────────────────────────────────
# 1) 站点自身
# ─────────────────────────────────────────────────────────────
# 分享海报上显示的站点地址（不填则用内置示例 your-domain.example/meowcha；部署到自己的域名时请填你的地址）
NEXT_PUBLIC_SITE_DISPLAY_URL=
# 分享海报二维码指向的完整地址（不填则由上面拼成 https://<上面>）
NEXT_PUBLIC_SITE_URL=

# ─────────────────────────────────────────────────────────────
# 2) 站点备案（中国大陆自部署才需要；不填则不显示备案药丸）
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_ICP_NUMBER=
NEXT_PUBLIC_POLICE_NUMBER=
NEXT_PUBLIC_POLICE_CODE=
# 公安备案图标地址（可留空；例如 /assets/badge_police.png）
NEXT_PUBLIC_POLICE_BADGE=

# ─────────────────────────────────────────────────────────────
# 3) 语音合成端点（可选）
#   游戏会把「要说的话」POST 到这个同源/跨源端点（body: {text, voiceId}，期望返回 audio/mpeg）。
#   不填则用同源 `/api/tts`（需要在 nginx 上把这个路径反代到你自己的 TTS 服务）。
#   仓库的 deploy/ 里提供了自建 edge-tts 服务示例（见 deploy/README.md）。
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_TTS_ENDPOINT=

# ─────────────────────────────────────────────────────────────
# 4) 大模型（LLM）——**不要写在这里**
#   ⚠️ 本项目的 LLM 地址/模型/密钥不是通过 env 注入的，而是存放在浏览器 localStorage，分两层：
#     · 服务器默认配置：部署时注入的 `prefill.js`（键 meowcha_api_config，会被锁定）。
#       复制 `deploy/prefill.js.example` → 部署目录下的 `prefill.js`，把 `__DEEPSEEK_KEY__` 换成你自己的 key。
#     · 玩家自定义配置：游戏首页「设置 → AI 模型」里填写（键 meowcha_user_api_config，不被锁定），
#       填写后优先于服务器默认配置；不填则自动回落到服务器默认配置。
#   ⚠️ 千万不要把填好 key 的 `prefill.js` 提交进仓库（.gitignore 已忽略）。
# ─────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────
# 5) Supabase（可选；仅「账号/额度」相关界面用到）
#   不填时相关界面不可用，但单机对局与邀请码联机不受影响。
# ─────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
